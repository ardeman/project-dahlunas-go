# Copy to .env.development or .env.production for local runs; see README.md.
# Never commit real values; on Cloud Run they come from Secret Manager.
PORT=8080
# Midtrans (sandbox keys until the account is approved). The server key also checks webhook signatures.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false
# Shared mode for both gateways; keep both flags false in sandbox and true in production.
SHOP_PRODUCTION=false
# Optional USD gateway; only needed for Lemon Squeezy catalog entries.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
# Enable only after the settings below are filled in.
SHOP_ENABLED=false
# Required for production checkout; optional in sandbox (set both or neither).
# Create a Turnstile widget restricted to SHOP_BASE_URL's hostname.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local sandbox origin below; production needs its actual public HTTPS origin.
SHOP_BASE_URL=http://localhost:8080
SHOP_SUPPORT_EMAIL=mail@ardeman.com
# Optional rotation for the default Coba Lagi catalog (defaults to 1).
# Leave unset when SHOP_CATALOG_FILE is configured.
SHOP_KEY_ID=
# Optional public JSON catalog for owned projects; see docs/projects.md.
SHOP_CATALOG_FILE=
# Supply your refund terms in both languages; quote values containing spaces.
SHOP_REFUND_ID=
SHOP_REFUND_EN=
# A verified sender domain in Resend is required for real recipients.
RESEND_API_KEY=
RESEND_FROM='Dahlunas <receipts@dahlunas.ardeman.com>'
# Firestore Native mode, default database in Jakarta.
# Shared project: orders-sandbox / orders-production; deploy separate Cloud Run services.
GOOGLE_CLOUD_PROJECT=dah-lunas
# Optional for local sandbox: localhost:8081 (no http:// prefix).
FIRESTORE_EMULATOR_HOST=
# Optional short-lived local credential; Cloud Run uses its service account.
# Leave unset when exporting a fresh token in your shell; Cloud Run uses IAM.
# GOOGLE_OAUTH_ACCESS_TOKEN=
# Optional bearer token (32+ characters, e.g. openssl rand -hex 32) for the
# scheduled delivery sweep at /tasks/deliveries; unset disables the route.
DAHLUNAS_TASK_TOKEN=
# Signing keys, one per project and key id: the 32-byte Ed25519 seed in hex (go run ./cmd/mint new-key).
# Use different seeds in sandbox and production; never put a real seed in this template.
DAHLUNAS_KEY_1_1=
